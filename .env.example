# ==========================================
# Curio Environment Configuration
# ==========================================

# Database Configuration
# Default for local dev: sqlite:///./content_vault.db
# For PostgreSQL with pgvector: postgresql://postgres:postgres@localhost:5432/content_vault
DATABASE_URL=sqlite:///./content_vault.db

# Redis (optional for local dev, used by Celery in Docker)
REDIS_URL=redis://localhost:6379

# ==========================================
# Open Models Configuration (Pick Any One)
# ==========================================

# 1. Groq (Ultra-fast inference with Llama 3.3, Mixtral)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# 2. OpenRouter (Access Meta Llama 3.3, DeepSeek, Mistral, Qwen)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Together AI (Open source models)
# Get key: https://api.together.ai
TOGETHER_API_KEY=

# 4. Local Open Models (Ollama, vLLM, LM Studio)
# Example for Ollama: http://localhost:11434/v1
AI_BASE_URL=

# Custom model override (Optional)
# Examples:
#   - llama-3.3-70b-versatile (Groq)
#   - meta-llama/llama-3.3-70b-instruct (OpenRouter)
#   - deepseek/deepseek-chat (OpenRouter)
#   - llama3.2 (Ollama)
AI_MODEL=

# ==========================================
# Proprietary Models (Optional Fallbacks)
# ==========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Calendar Integration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback

# Storage Settings
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage

# App Security
APP_SECRET=curio-development-secret-key-replace-in-production
DEBUG=True
